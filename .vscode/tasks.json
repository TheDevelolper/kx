{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Add projects to solution",
			"type": "shell",
			"command": "dotnet sln Kx.slnx add $(find . -name \"*.csproj\")",
			"options": {
				"cwd": "${workspaceFolder}/src"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Install Template",
			"type": "shell",
			"command": "dotnet new install ./templates/kx-starter --force",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Uninstall Template",
			"type": "shell",
			"command": "dotnet new uninstall ./templates/kx-starter",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}, 
		{
			"label": "Create New Project From Template",
			"type": "shell",
			"command": "dotnet new kx-starter -n ${input:projectName} -o ${workspaceFolder}/src/${input:projectName}",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		} 

	],
	"inputs": [
		{
			"id": "projectName",
			"type": "promptString",
			"description": "The name of the project",
			"default": "MyExampleProject"
		}
	]
}